### Sandbox (lokaal oefenen) ###
# Alles onder het app-package behalve de Boot-entrypoint
sandbox/src/main/java/io/praetore/springexam/**
!sandbox/src/main/java/io/praetore/springexam/SpringExamApplication.java
# Tests: alleen de minimale smoke-test in git; overige gegenereerde tests lokaal
sandbox/src/test/java/io/praetore/springexam/**
!sandbox/src/test/java/io/praetore/springexam/SpringExamApplicationTests.java
# Lokale sandbox-artifacts: HTTP Client + filesystem-XML e.d. (alleen .gitkeep in git)
sandbox/.temp/*
!sandbox/.temp/.gitkeep
# Runtime resources: map + minimale application.properties in git; rest lokaal
sandbox/src/main/resources/**
!sandbox/src/main/resources/.gitkeep
!sandbox/src/main/resources/application.properties

### Exam ELO (Vite) ###
exam/node_modules/
exam/dist/
# Lokale ELO-vragenbank (schema + example wél in git)
exam/src/data/questions.json

