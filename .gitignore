### Backend sandbox (lokaal oefenen) ###
# Alles onder het app-package behalve de Boot-entrypoint
backend/src/main/java/io/praetore/springexam/**
!backend/src/main/java/io/praetore/springexam/SpringExamApplication.java
# Tests: alleen de minimale smoke-test in git; overige gegenereerde tests lokaal
backend/src/test/java/io/praetore/springexam/**
!backend/src/test/java/io/praetore/springexam/SpringExamApplicationTests.java
# Lokale sandbox-artifacts: HTTP Client + filesystem-XML e.d. (alleen .gitkeep in git)
backend/.temp/*
!backend/.temp/.gitkeep
# Runtime resources: map + minimale application.properties in git; rest lokaal
backend/src/main/resources/**
!backend/src/main/resources/.gitkeep
!backend/src/main/resources/application.properties

### Frontend (Vite) ###
frontend/node_modules/
frontend/dist/
# Lokale ELO-vragenbank (schema + example wél in git)
frontend/src/data/questions.json

