{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praetore.io/schemas/exam-question.json",
  "title": "SpringExamQuestion",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "topic", "difficulty", "elo", "type", "prompt", "choices", "answer", "explanation"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "enum": ["ioc", "aop", "transactions", "mvc", "testing", "security", "boot"]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "elo": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "enum": ["single", "multi", "code"]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "answer": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "trap": {
      "type": "string"
    }
  }
}
